# PostgreSQL wire-protocol URLs. Require SSL for hosted/Supabase databases.
DATABASE_URL=postgresql+psycopg://videoops:change-me@localhost:5432/videoops
TEST_DATABASE_URL=postgresql+psycopg://videoops:videoops_test@localhost:55432/videoops_test
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Stock providers are optional; local generated backgrounds remain available.
PEXELS_API_KEY=
PIXABAY_API_KEY=

WORKER_ID=videoops-worker-1
WORK_LEASE_SECONDS=300
WORK_POLL_INTERVAL_SECONDS=2.0
WORK_MAX_ATTEMPTS=3

# This is an operational gate, not authentication. Keep false on public deployments.
CHANNEL_ADMIN_ENABLED=false

# Credential references resolve these read-only environment bundles.
YT_TECH_YOUTUBE_CLIENT_ID=
YT_TECH_YOUTUBE_CLIENT_SECRET=
YT_TECH_YOUTUBE_REFRESH_TOKEN=
TT_TECH_TIKTOK_SESSION=

# AI Story. Script input works while disabled; prompt input requires model + key.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_MAX_ATTEMPTS=3
LLM_PROMPT_VERSION=story-v1
GEMINI_API_KEY=
OPENAI_API_KEY=
STORY_MIN_CHARACTERS=100
STORY_MAX_CHARACTERS=20000
STORY_MAX_SCENES=100
STORY_MAX_KEYWORDS_PER_SCENE=10

# Module 6 preview media worker
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
TTS_CONNECT_TIMEOUT_SECONDS=10
TTS_RECEIVE_TIMEOUT_SECONDS=60
STOCK_REQUEST_TIMEOUT_SECONDS=20
STOCK_MAX_DOWNLOAD_BYTES=104857600
PREVIEW_RENDER_TIMEOUT_SECONDS=300
PREVIEW_DURATION_TOLERANCE_MS=250
MEDIA_MIN_FREE_DISK_GB=0.25
MEDIA_MAX_ATTEMPTS=3
MEDIA_RENDER_CONCURRENCY=1

# Module 7 remix ingestion worker
YTDLP_BINARY=yt-dlp
REMIX_DOWNLOAD_TIMEOUT_SECONDS=300
REMIX_MAX_DOWNLOAD_BYTES=1073741824
REMIX_MAX_SOURCES=10
REMIX_MAX_SOURCE_DURATION_SECONDS=7200
REMIX_DURATION_TOLERANCE_MS=750

# Module 8 approved master rendering
MASTER_RENDER_TIMEOUT_SECONDS=900
MASTER_PRESET=superfast
MASTER_CRF=23
MASTER_DURATION_TOLERANCE_MS=1000
